# Copy this file to application-local.yml and configure it locally.
# application-local.yml is ignored by Git and is not packaged in the JAR.

spring:
  datasource:
    url: "${DB_URL:jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:zhiyunjiaos}?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true}"
    username: "${DB_USERNAME:root}"
    password: "${DB_PASSWORD:}"

jwt:
  secret: "${JWT_SECRET:REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS}"

security:
  auth:
    enabled: true

app:
  redis:
    enabled: false

management:
  health:
    redis:
      enabled: false

moonshot:
  api:
    key: "YOUR_MOONSHOT_API_KEY"

aliyun:
  nls:
    app-key: "YOUR_ALIYUN_NLS_APP_KEY"
    # Prefer RAM credentials so the backend can refresh NLS tokens automatically.
    token: ""
    access-key-id: "YOUR_ALIYUN_ACCESS_KEY_ID"
    access-key-secret: "YOUR_ALIYUN_ACCESS_KEY_SECRET"

asr:
  api:
    url: "http://127.0.0.1:9977/asr"
    token: ""

tts:
  api:
    url: "http://127.0.0.1:9880/tts"

sound-clone:
  api:
    url: "http://127.0.0.1:9880/tts"
