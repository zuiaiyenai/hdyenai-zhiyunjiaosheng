# Copy this file to application-local.yml and configure it locally.
# application-local.yml is ignored by Git and is not packaged in the JAR.

spring:
  datasource:
    url: "jdbc:mysql://localhost:3306/zhiyunjiaos?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"
    username: root
    password: "${DB_PASSWORD:YOUR_MYSQL_PASSWORD}"
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: "${REDIS_PASSWORD:}"
      database: 9

jwt:
  secret: "${JWT_SECRET:REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS}"

moonshot:
  api:
    key: "${MOONSHOT_API_KEY:}"

asr:
  api:
    url: http://127.0.0.1:9977/asr
    token: "${ASR_API_TOKEN:}"

tts:
  api:
    url: http://127.0.0.1:9966/tts

sound-clone:
  api:
    url: http://127.0.0.1:9880/tts

cosyvoice:
  api:
    url: "${COSYVOICE_API_URL:}"
    key: "${COSYVOICE_API_KEY:}"

app:
  redis:
    enabled: true
