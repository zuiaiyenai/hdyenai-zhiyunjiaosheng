# Copy to .env for Docker Compose. Values below are examples, not production secrets.
DB_NAME=zhiyunjiaos
DB_USERNAME=tts
DB_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DB_PORT=3306

REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379
REDIS_DATABASE=0

JWT_SECRET=replace-with-a-random-string-at-least-32-characters
SERVER_PORT=8081
MANAGEMENT_PORT=9091
CORS_ALLOWED_ORIGINS=http://localhost:8081
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
APP_ENVIRONMENT=docker
EXTERNAL_SERVICES_REQUIRED=false
TTS_HEALTH_URL=http://host.docker.internal:9880/tts
ASR_HEALTH_URL=http://host.docker.internal:9977/health
PROMETHEUS_PORT=9090

MOONSHOT_API_KEY=
ALIYUN_NLS_APP_KEY=
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ASR_API_URL=http://host.docker.internal:9977/asr
TTS_API_URL=http://host.docker.internal:9880/tts
SOUND_CLONE_API_URL=http://host.docker.internal:9880/tts
